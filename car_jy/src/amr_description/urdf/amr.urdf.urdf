<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="amr">
	<xacro:property name="wheel_radius" value="0.065"/> 		<xacro:property name="wheel_sep" value="0.30"/> 

	<!-- base_link --> 
	<link name="base_link"/>
	<joint name="base_to_imu" type="fixed"> 
		<parent link="base_link"/>
		<child link="imu_link"/> 
		<origin xyz="0 0 0" rpy="0 0 0"/> 
	</joint> 
	<link name="imu_link"/> 

	<!-- wheels (continuous joints for diff-drive) --> 
	<joint name="base_to_wheel_left" type="continuous"> 
		<parent link="base_link"/><child link="wheel_left_link"/> 
		<axis xyz="0 0 1"/> 
		<origin xyz="0 ${wheel_sep/2} 0" rpy="0 0 0"/> 
	</joint> 
	<link name="wheel_left_link"/> 
	<joint name="base_to_wheel_right" type="continuous"> 
		<parent link="base_link"/><child link="wheel_right_link"/> 
		<axis xyz="0 0 1"/> 
		<origin xyz="0 -${wheel_sep/2} 0" rpy="0 0 0"/> 
	</joint> 
	<link name="wheel_right_link"/> 

	<!-- laser --> 
	<joint name="base_to_laser" type="fixed"> 	
		<parent link="base_link"/><child link="laser_frame"/> 
		<origin xyz="0.10 0 0.20" rpy="0 0 0"/> 
	</joint> 
	<link name="laser_frame"/>
</robot>