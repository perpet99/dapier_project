<?xml version="1.0"?>
<robot name="amr">

  <!-- 1. base_footprint (바닥 접지면 중심) -->
  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>

  <!-- 2. base_link (로봇 본체 메인 프레임: 세로 35cm, 가로 45cm, 높이 73.5cm, 바닥 기준 1.5cm~75cm) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.3425" rpy="0 0 0"/>
      <geometry>
        <box size="0.35 0.45 0.735"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.4 0.85 0.85"/>
      </material>
    </visual>
  </link>

  <!-- 3. 전방 좌측 바퀴 (wheel_front_left_link: 지름 8cm, X=+0.13, Y=+0.24) -->
  <joint name="base_to_wheel_front_left" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_front_left_link"/>
    <origin xyz="0.13 0.24 0" rpy="-1.5707963 0 0"/>
  </joint>
  <link name="wheel_front_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.025" radius="0.04"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <!-- 4. 후방 좌측 바퀴 (wheel_rear_left_link: 지름 8cm, X=-0.13, Y=+0.24) -->
  <joint name="base_to_wheel_rear_left" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_rear_left_link"/>
    <origin xyz="-0.13 0.24 0" rpy="-1.5707963 0 0"/>
  </joint>
  <link name="wheel_rear_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.025" radius="0.04"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <!-- 5. 전방 우측 바퀴 (wheel_front_right_link: 지름 8cm, X=+0.13, Y=-0.24) -->
  <joint name="base_to_wheel_front_right" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_front_right_link"/>
    <origin xyz="0.13 -0.24 0" rpy="-1.5707963 0 0"/>
  </joint>
  <link name="wheel_front_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.025" radius="0.04"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <!-- 6. 후방 우측 바퀴 (wheel_rear_right_link: 지름 8cm, X=-0.13, Y=-0.24) -->
  <joint name="base_to_wheel_rear_right" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_rear_right_link"/>
    <origin xyz="-0.13 -0.24 0" rpy="-1.5707963 0 0"/>
  </joint>
  <link name="wheel_rear_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.025" radius="0.04"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <!-- 7. 라이다 센서 (laser_frame: 상단 전방) -->
  <joint name="base_to_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0.095 0 0.735" rpy="0 0 0"/>
  </joint>
  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.035"/>
      </geometry>
      <material name="red">
        <color rgba="0.9 0.15 0.15 1.0"/>
      </material>
    </visual>
  </link>

  <!-- 8. 전방 카메라 센서 (camera_link: 앞면 중앙 X=0.175, 바닥 기준 66cm -> Z=0.620) -->
  <joint name="base_to_camera" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.175 0 0.620" rpy="0 0 0"/>
  </joint>
  <link name="camera_link">
    <visual>
      <origin xyz="0.006 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.0113 0.030 0.025"/>
      </geometry>
      <material name="cam_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
  </link>

  <!-- 9. IMU 센서 (imu_link) -->
  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>

</robot>
